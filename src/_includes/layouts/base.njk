<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · Eli Thullen</title>
  <meta name="description" content="{{ description or 'Writing by Eli Thullen.' }}">

  <meta property="og:title" content="{{ title }} · Eli Thullen">
  <meta property="og:description" content="{{ description or 'Writing by Eli Thullen.' }}">
  <meta property="og:type" content="article">

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon.png" type="image/png" sizes="96x96">
  <link rel="apple-touch-icon" href="/assets/favicon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="page">

    <header class="margin-note">
      <a href="/">elithullen.com</a>
      <span class="dot" aria-hidden="true"></span>
      <span>{{ marginNote or "writing" }}</span>
    </header>

    {{ content | safe }}

    <footer class="colophon">
      <span class="trackpoint" aria-hidden="true"></span>
      <p>&copy; {% year %} Eli Thullen</p>
    </footer>

  </main>
</body>
</html>
