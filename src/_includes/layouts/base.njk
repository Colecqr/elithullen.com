<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · Eli Thullen</title>
  <meta name="description" content="{{ description or 'Writing by Eli Thullen.' }}">

  <meta property="og:title" content="{{ title }} · Eli Thullen">
  <meta property="og:description" content="{{ description or 'Writing by Eli Thullen.' }}">
  <meta property="og:type" content="article">

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23f6f1e5'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%23c1121f'/%3E%3C/svg%3E">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="page">

    <header class="margin-note">
      <a href="/">elithullen.com</a>
      <span class="dot" aria-hidden="true"></span>
      <span>{{ marginNote or "writing" }}</span>
    </header>

    {{ content | safe }}

    <footer class="colophon">
      <span class="trackpoint" aria-hidden="true"></span>
      <p>&copy; {% year %} Eli Thullen</p>
    </footer>

  </main>
</body>
</html>
