---
layout: layouts/base.njk
---
<article class="piece">
  <h1 class="piece-title">{{ title }}</h1>

  <p class="piece-meta">
    {% if role %}<span>{{ role }}</span>{% endif %}
    {% if role and year %}<span class="meta-sep" aria-hidden="true">/</span>{% endif %}
    {% if year %}<span>{{ year }}</span>{% endif %}
  </p>

  {# A video leads the page when present; otherwise fall back to a cover image. #}
  {% if video %}
    {% youtube video, title %}
  {% elif cover %}
    <img class="project-cover" src="{{ cover }}" alt="{{ coverAlt or title }}">
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  {% if link or source %}
    <p class="project-links">
      {% if link %}<a href="{{ link }}" target="_blank" rel="noopener noreferrer">View project</a>{% endif %}
      {% if source %}<a href="{{ source }}" target="_blank" rel="noopener noreferrer">Source</a>{% endif %}
    </p>
  {% endif %}

  {% include "partials/reactions.njk" %}
</article>

<a class="back" href="/work/">Back to Work</a>
