---
layout: layouts/base.njk
---
<article class="piece">
  <h1 class="piece-title">{{ title }}</h1>

  <p class="piece-meta">
    {% if role %}<span>{{ role }}</span>{% endif %}
    {% if role and year %}<span class="meta-sep" aria-hidden="true">/</span>{% endif %}
    {% if year %}<span>{{ year }}</span>{% endif %}
  </p>

  {# A video leads the page when present; otherwise fall back to a cover image. #}
  {% if video %}
    {% youtube video, title %}
  {% elif cover %}
    <img class="project-cover" src="{{ cover }}" alt="{{ coverAlt or title }}">
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  {# PDFs are linked, never embedded — mobile browsers render framed PDFs
     badly or not at all. #}
  {% if pdf %}
    <a class="pdf-link" href="{{ pdf }}" target="_blank" rel="noopener noreferrer">
      <svg class="pdf-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M6 2h8.2L20 7.8V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm8.6 2.3v3.9h3.9l-3.9-3.9z"/>
      </svg>
      <span class="pdf-text">
        <span class="pdf-label">{{ pdfLabel or "View PDF" }}</span>
        <span class="pdf-hint">opens in a new tab</span>
      </span>
      <span class="pdf-arrow" aria-hidden="true">&rarr;</span>
    </a>
  {% endif %}

  {% if link or source %}
    <p class="project-links">
      {% if link %}<a href="{{ link }}" target="_blank" rel="noopener noreferrer">View project</a>{% endif %}
      {% if source %}<a href="{{ source }}" target="_blank" rel="noopener noreferrer">Source</a>{% endif %}
    </p>
  {% endif %}
</article>

<a class="back" href="/work/">Back to Work</a>
