<div class="reactions" data-reactions data-slug="{{ page.url }}">
  <button class="reaction" type="button" data-emoji="heart" aria-label="React with a heart">
    <span class="reaction-glyph" aria-hidden="true">&#10084;&#65039;</span>
    <span class="reaction-count" data-count>&middot;</span>
  </button>
  <button class="reaction" type="button" data-emoji="cry" aria-label="React with a sob">
    <span class="reaction-glyph" aria-hidden="true">&#128557;</span>
    <span class="reaction-count" data-count>&middot;</span>
  </button>
  <button class="reaction" type="button" data-emoji="poop" aria-label="React with a pile of poo">
    <span class="reaction-glyph" aria-hidden="true">&#128169;</span>
    <span class="reaction-count" data-count>&middot;</span>
  </button>
</div>
